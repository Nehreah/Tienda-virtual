# Plantilla de variables para Docker Compose.
#
# CÓMO USARLA (una sola vez, en el servidor, en la misma carpeta que docker-compose.yml):
#     cp .env.example .env
#     nano .env            # reemplaza TODOS los valores que dicen "cambiar_..."
#     docker compose up -d --build
#
# Docker Compose lee el archivo ".env" solo, sin que tengas que hacer nada más.
# NUNCA subas ".env" al repositorio (ya está en .gitignore): contiene tus claves reales.
# Esta plantilla (".env.example") sí se sube: no lleva claves.
# Evita el signo $ dentro de las claves: Compose lo interpreta como variable.
#
# Si arrancas con ./start.sh o start.bat NO necesitas este archivo: usan local.properties.

# ---------------------------------------------------------------------------------------
# OBLIGATORIAS: sin ellas "docker compose up" se detiene con un mensaje claro
# ---------------------------------------------------------------------------------------

# Clave de la base de datos que levanta el propio compose.
# POSTGRES_PASSWORD y DATABASE_PASSWORD deben ser EXACTAMENTE la misma.
POSTGRES_PASSWORD=cambiar_clave_de_la_base
DATABASE_PASSWORD=cambiar_clave_de_la_base

# Acceso al tablero. En producción la clave debe tener 12 o más caracteres
# (genera una con:  openssl rand -base64 24 ).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambiar_clave_del_tablero_12_o_mas
# Opcional: usuario de solo lectura (ve todo, no modifica nada). Definir los dos o ninguno; clave de 12+ caracteres.
# DASHBOARD_VIEWER_USER=socio
# DASHBOARD_VIEWER_PASSWORD=
# Opcional: secreto para firmar las sesiones (openssl rand -base64 32). Sin él, las sesiones se cierran al reiniciar.
# SESSION_SECRET=

# ---------------------------------------------------------------------------------------
# META (WhatsApp, Instagram, Messenger). Déjalas vacías las que no uses.
# ---------------------------------------------------------------------------------------

# App Secret de tu app de Meta (Configuración > Básica). Sin él, el webhook responde 503.
META_APP_SECRET=
# Texto secreto que TÚ inventas (openssl rand -base64 24). Debe ser idéntico al que escribas
# en Meta for Developers, campo "Verify token", al configurar el webhook.
META_WEBHOOK_VERIFY_TOKEN=
# Token de acceso de Meta (catálogo, Instagram y Messenger).
META_ACCESS_TOKEN=
# ID de tu página de Facebook (se usa también para Instagram y Messenger).
META_PAGE_ID=
# ID del catálogo de Meta Commerce.
META_CATALOG_ID=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
# El ID largo que aparece junto al número en el panel de WhatsApp (NO es el número de teléfono).
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------------------
# SHOPIFY (opcional)
# ---------------------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_LOCATION_ID=

# ---------------------------------------------------------------------------------------
# OTRAS (opcionales)
# ---------------------------------------------------------------------------------------

# Clave de Gemini; vacía = el bot usa reglas locales sin IA.
GEMINI_API_KEY=
# URL pública de tu tienda, sin barra final (ej.: https://tu-dominio.com).
PUBLIC_BASE_URL=
# Instrucciones de pago que el bot envía al cliente.
PAYMENT_INSTRUCTIONS=
# Por seguridad el sistema NO escribe en Shopify/Meta hasta que lo pongas en true.
CHANNEL_WRITE_ENABLED=false
# true solo si hay un proxy (nginx, Caddy, Cloudflare) delante de la app.
TRUST_PROXY=false
# Dominio del que se aceptan peticiones CORS (vacío = ninguno).
CORS_ALLOWED_HOST=
# Puerto en el que se publica la app en el servidor.
PORT=8080
